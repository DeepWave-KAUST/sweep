# Copy to gate/env.sh and edit the paths. Machine-specific, so gate/env.sh is
# NOT tracked: it names an interpreter, a source tree and an extension cache
# that only exist on one box.
export SWEEP_WT=/path/to/your/worktree
export PY=/path/to/python                 # the interpreter with torch + CUDA
export PYTHONPATH=$SWEEP_WT/src
export TORCH_EXTENSIONS_DIR=/path/to/a/private/extension/cache
export TORCH_CUDA_ARCH_LIST=8.9           # 7.0 V100, 8.0 A100, 8.9 Ada, 9.0 H100
export OMP_NUM_THREADS=8                  # pytest/OMP cap; unbounded OMP thrashes
export CUDA_VISIBLE_DEVICES=0             # one GPU: the gate is not a benchmark
